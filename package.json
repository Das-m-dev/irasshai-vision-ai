{
  "name": "reception-character",
  "version": "0.1.0",
  "private": true,
  "description": "Camera-based presence-triggered animated reception character (Electron + React + MediaPipe)",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.6",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.14",
    "@rive-app/react-canvas": "^4.18.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "com.yourcompany.reception-character",
    "files": ["dist/**", "electron/**"],
    "directories": { "output": "release" }
  }
}
